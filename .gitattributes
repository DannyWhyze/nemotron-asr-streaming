# Set default behaviour to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files that must retain CRLF line endings on Windows
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Denote all binary files that should not be touched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary
*.flac binary
*.gguf binary
*.safetensors binary
*.bin binary
